@Tutorial(time: 15) {
    @Intro(title: "visionOS에서 RCP Scene 불러오기") {
        Swift로 저장한 Scene을 불러와요.\
        불러온 Scene을 `RealityView`⁠에 넣어요.\
        버튼으로 Immersive Space를 열고 닫아요.

        ## 이번 실습

        스텝마다 수정할 파일 전체가 보여요.\
        강조된 줄을 보면 코드를 넣을 위치를 알 수 있어요.

        ## 실습 요약

        - **준비할 것:** 저장한 RCP Scene
        - **만들 파일:** `AppModel.swift`
        - **실습 시간:** **15분**
    }

    @Section(title: "AppModel로 상태 만들기") {
        @ContentAndMedia {
            Space가 열렸는지에 따라 버튼의 동작이 달라져요.

            여러 View가 읽을 상태를 `AppModel`⁠에 만들어요.
        }

        @Steps {
            @Step {
                **`AppModel.swift`⁠를 만들어요.** 새 파일에 `AppModel` 클래스를 선언해요.\
                \
                `@Observable`⁠을 붙여 View가 상태 변화를 읽게 해요.\
                `@MainActor`⁠에서 UI 상태를 관리해요.

                @Code(name: "AppModel.swift", file: "AppModel-FocusStructure.swift", previousFile: "AppModel-BeforeStructure.swift")
            }

            @Step {
                **세 가지 상태를 추가해요.** 닫혀 있을 때: `closed`\
                열거나 닫는 중: `inTransition`\
                열려 있을 때: `open`\
                \
                앱을 처음 열 땐 Space가 닫혀 있어요.\
                처음 상태는 `.closed`⁠예요.

                @Code(name: "AppModel.swift", file: "AppModel-FocusState.swift", previousFile: "AppModel-BeforeState.swift")
            }
        }
    }

    @Section(title: "상태를 공유하고 Space 등록하기") {
        @ContentAndMedia {
            창과 Immersive Space에 같은 `AppModel`⁠을 넘겨요.\
            그래야 버튼과 Space가 같은 상태를 봐요.

            실물과 비행기가 함께 보이는 모드로 등록해요.\
            모드 설정: `.mixed`.\
            앞에서 만든 Object Anchor가 실물을 알아봐요.
        }

        @Steps {
            @Step {
                **AppModel을 만들고 창에 넘겨요.** 앱에서 `@State`⁠로 `AppModel`⁠을 한 번 만들어요.\
                \
                창 안의 버튼도 같은 상태를 읽을 수 있게 해요.\
                `ContentView`⁠에 붙일 코드:\
                `.environment(appModel)`

                @Code(name: "ObjectTrackingWithRCPApp.swift", file: "App-FocusSharedModel.swift", previousFile: "App-BeforeSharedModel.swift")
            }

            @Step {
                **Immersive Space를 등록해요.** Space ID: `ObjectTrackingSpace`\
                나중에 버튼에서 이 이름으로 Space를 열어요.\
                \
                `ImmersiveView`⁠에도 같은 `appModel`⁠을 넘겨요.\
                마지막으로 `.mixed`⁠를 골라요.\
                현실과 비행기가 함께 보여요.

                @Code(name: "ObjectTrackingWithRCPApp.swift", file: "App-FocusImmersiveSpace.swift", previousFile: "App-BeforeImmersiveSpace.swift")
            }
        }
    }

    @Section(title: "RealityView에 Scene 불러오기") {
        @ContentAndMedia {
            Scene은 아래 패키지에 저장돼요.\
            `RealityKitContent`

            Swift에서 Scene 전체를 불러와요.\
            표시할 곳: `RealityView`

            Anchor와 비행기의 배치는 이미 Scene에 있어요.\
            Swift에서 위치를 다시 계산할 필요는 없어요.

            @Image(source: rcp-scene-runtime-flow, alt: "RealityKitContent의 ObjectTrackingScene을 RealityView로 불러오는 흐름")
        }

        @Steps {
            @Step {
                **ImmersiveView에 RealityView를 만들어요.** 아래 세 모듈을 가져와요.\
                `SwiftUI`\
                `RealityKit`\
                `RealityKitContent`\
                \
                이제 Scene을 넣을 `content` 클로저를 준비해요.

                @Code(name: "ImmersiveView.swift", file: "ImmersiveView-FocusStructure.swift", previousFile: "ImmersiveView-BeforeStructure.swift")
            }

            @Step {
                **Scene을 불러와 화면에 추가해요.** `Entity(named:in:)`⁠에 Anchor 이름이 아니라 Scene 이름을 넣어요.\
                예제에서는 `ObjectTrackingScene`⁠이에요.\
                \
                Scene을 불러올 번들:\
                `realityKitContentBundle`\
                불러온 Entity를 `content.add`⁠로 추가해요.\
                실패하면 Xcode Console에서 이름과 번들을 확인해요.

                @Code(name: "ImmersiveView.swift", file: "ImmersiveView-FocusLoad.swift", previousFile: "ImmersiveView-BeforeLoad.swift")
            }
        }
    }

    @Section(title: "창에 시작 버튼 놓기") {
        @ContentAndMedia {
            앱을 실행하면 먼저 창이 보여요.\
            이 창에 Object Tracking을 시작할 버튼을 놓아요.
        }

        @Steps {
            @Step {
                **`ContentView`⁠에 버튼을 넣어요.** 수정할 파일: `ContentView.swift`\
                추가할 버튼: `ImmersiveSpaceButton`\
                \
                이번엔 창에 버튼만 보여줘요.\
                열고 닫는 동작은 다음 단계에서 연결해요.

                @Code(name: "ContentView.swift", file: "ContentView-FocusButton.swift", previousFile: "ContentView-BeforeButton.swift")
            }
        }
    }

    @Section(title: "버튼을 현재 상태와 연결하기") {
        @ContentAndMedia {
            버튼은 `AppModel`⁠의 상태에 맞는 동작을 보여줘요.\
            Space를 여닫을 땐 SwiftUI environment의 동작을 써요.
        }

        @Steps {
            @Step {
                **상태에 따라 버튼 문구를 바꿔요.** 닫힘: ‘오브젝트 트래킹 시작’\
                열림: ‘오브젝트 트래킹 종료’\
                \
                전환 중에는 ‘처리 중...’을 표시하고 버튼을 잠가요.\
                버튼을 누르면 다음 단계에서 작성할 함수를 호출해요.\
                호출할 함수: `toggleImmersiveSpace()`

                @Code(name: "ImmersiveSpaceButton.swift", file: "ImmersiveSpaceButton-FocusUI.swift", previousFile: "ImmersiveSpaceButton-BeforeUI.swift")
            }
        }
    }

    @Section(title: "버튼으로 Space 열고 닫기") {
        @ContentAndMedia {
            이제 버튼이 눌렸을 때 할 일을 연결해요.\
            상태에 따라 Space를 열거나 닫아요.\
            전환이 끝나기 전에는 다시 실행하지 않아요.
        }

        @Steps {
            @Step {
                **닫혀 있으면 Space를 열어요.** 먼저 상태를 `.inTransition`⁠으로 바꿔요.\
                앱에 등록한 ID로 Space를 열어요.\
                예제 ID: `ObjectTrackingSpace`\
                \
                열리면 `.open`⁠으로 바꿔요.\
                취소되거나 실패하면 `.closed`⁠로 돌아가요.

                @Code(name: "ImmersiveSpaceButton.swift", file: "ImmersiveSpaceButton-FocusOpen.swift", previousFile: "ImmersiveSpaceButton-BeforeOpen.swift")
            }

            @Step {
                **열려 있으면 Space를 닫아요.** 먼저 상태를 `.inTransition`⁠으로 바꿔요.\
                닫기 함수: `dismissImmersiveSpace()`\
                닫기 함수가 끝나면 `.closed`⁠로 되돌려요.\
                \
                전환 중에는 새 작업을 시작하지 않아요.

                @Code(name: "ImmersiveSpaceButton.swift", file: "ImmersiveSpaceButton-FocusClose.swift", previousFile: "ImmersiveSpaceButton-BeforeClose.swift")
            }
        }
    }

    @Section(title: "시뮬레이터에서 확인하기") {
        @ContentAndMedia {
            여기서는 Apple Vision Pro 없이 확인할 수 있어요.\
            visionOS 시뮬레이터에서 앱을 빌드해요.\
            버튼으로 Space를 열고 닫을 수 있는지 봐요.

            Scene을 불러왔다고 실물을 인식한 건 아니에요.\
            실물 추적은 Chapter 4에서 Apple Vision Pro로 확인해요.
        }

        @Steps {
            @Step {
                **앱을 빌드해요.** Xcode에서 visionOS 시뮬레이터를 선택하고 빌드해요.\
                빌드 결과에서 Swift 코드와 RCP 자산의 오류를 확인해요.

                @Image(source: simulator-build-check, alt: "실행 대상으로 Apple Vision Pro 시뮬레이터를 고르고 빌드에 실패하면 Issue navigator를 확인하는 그림")
            }

            @Step {
                **버튼을 눌러 열고 닫아 봐요.** 앱을 실행한 뒤 버튼을 눌러요.\
                \
                상태에 따라 버튼 문구가 바뀌는지 봐요.\
                전환 중에는 버튼이 잠겨 있어야 해요.

                @Image(source: "visionos-app-button-closed.png", alt: "visionOS 시뮬레이터에 오브젝트 트래킹 시작 버튼이 표시된 화면")
            }

            @Step {
                **Scene을 불러왔는지 확인해요.** Space를 연 뒤 Xcode Console을 봐요.\
                \
                ‘오브젝트 트래킹 Scene 로드 실패’가 보이면 Scene 이름과 번들을 다시 확인해요.

                @Image(source: simulator-scene-console-check, alt: "Scene 로드 실패 문구가 보이면 ObjectTrackingScene 이름과 realityKitContentBundle을 확인하는 그림")
            }

            @Step {
                **시뮬레이터에서 확인할 범위를 구분해요.** 여기서는 앱과 Scene이 연결되는 것까지 확인해요.\
                실물 인식과 비행기의 위치는 Chapter 4에서 확인해요.

                @Image(source: simulator-versus-device-check, alt: "시뮬레이터에서 확인할 앱과 Scene 연결, Apple Vision Pro에서 확인할 실물 인식과 비행기 위치를 비교한 그림")
            }
        }
    }
}
